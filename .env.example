# Base URL of the backend API, including the /api suffix. Every
# src/api/*.ts client falls back to http://localhost:5001/api if this
# is unset, so it's optional for local development against a backend
# running on its default port — but must be set explicitly in
# production to point at the deployed Render backend URL.
VITE_API_BASE_URL=http://localhost:5001/api
