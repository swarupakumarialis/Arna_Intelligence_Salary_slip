# Port the Express server listens on. Render sets its own PORT at
# runtime — this value is only used for local development.
PORT=5000

NODE_ENV=development

# MongoDB Atlas connection string (mongodb+srv://...). Required — the
# server will refuse to serve data requests without it.
MONGODB_URI=

# Resend (https://resend.com) — used by the Email Automation feature
# to send salary slips (Sprint 6.3; replaced Gmail SMTP after
# diagnostics proved Render cannot open outbound SMTP connections to
# smtp.gmail.com at all — see services/email.service.js). Get
# RESEND_API_KEY from the Resend dashboard. EMAIL_FROM must be either
# an address on a domain you've verified with Resend, or their
# sandbox "onboarding@resend.dev" address until a custom domain is
# configured. Supports the "Display Name <address>" format, e.g.:
#   EMAIL_FROM=Arna Intelligence <payroll@yourdomain.com>
RESEND_API_KEY=
EMAIL_FROM=

# Exact origin of the deployed frontend (no trailing slash) — the
# backend's CORS policy only allows this one origin, so a mismatch
# here silently breaks every API call from the frontend with a CORS
# error. package.json's "dev" script runs Vite on port 3000
# (--port=3000), not Vite's default 5173 — match that for local dev.
# Set this to the Vercel deployment URL in production.
FRONTEND_URL=http://localhost:3000

# Google Drive OAuth (Sprint 6.2A) — used by services/storage/googleDriveProvider.js
# to let HR connect Google Drive once via OAuth 2.0 and have generated
# salary slips uploaded there automatically. Create these under an
# OAuth Client (type "Web application") in Google Cloud Console, with
# the Drive API enabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must exactly match an "Authorized redirect URI" registered on the
# OAuth Client above, or Google will reject the callback with
# redirect_uri_mismatch. Falls back to a localhost URL for local dev
# if unset; must be set explicitly in production (e.g. on Render) to
# https://<your-backend-domain>/api/integrations/google-drive/callback
GOOGLE_REDIRECT_URI=http://localhost:5000/api/integrations/google-drive/callback
