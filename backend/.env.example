# Port the Express server listens on. Render sets its own PORT at
# runtime — this value is only used for local development.
PORT=5000

NODE_ENV=development

# MongoDB Atlas connection string (mongodb+srv://...). Required — the
# server will refuse to serve data requests without it.
MONGODB_URI=

# Gmail (or other SMTP-compatible) credentials used by the Email
# Automation feature to send salary slips. EMAIL_PASS must be an app
# password, not the account's login password.
EMAIL_USER=
EMAIL_PASS=

# Exact origin of the deployed frontend (no trailing slash) — the
# backend's CORS policy only allows this one origin, so a mismatch
# here silently breaks every API call from the frontend with a CORS
# error. package.json's "dev" script runs Vite on port 3000
# (--port=3000), not Vite's default 5173 — match that for local dev.
# Set this to the Vercel deployment URL in production.
FRONTEND_URL=http://localhost:3000
